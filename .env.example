# ===== InsightForge Environment Variables =====
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to Git.

# Google AI Studio (Gemini API)
GOOGLE_API_KEY=

# Tavily (Web Search)
TAVILY_API_KEY=

# LangSmith (Observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightforge

# PostgreSQL (used from Week 8 onwards; SQLite used for local dev initially)
POSTGRES_URL=

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# AWS (used from Week 12 onwards)
AWS_REGION=
